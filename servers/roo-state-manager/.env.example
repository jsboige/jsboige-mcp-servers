# =============================================================================
# CRITICAL — DO NOT EMPTY OR DELETE VALUES (Issue #1551)
# =============================================================================
# The MCP server validates these at startup (see src/index.ts REQUIRED_ENV_VARS).
# Since #1635, a missing/empty REQUIRED variable no longer exits the process:
# the server starts in DEGRADED mode and the tools using that variable return
# an explicit error. Keep the values filled anyway.
# NEVER set a key to "" to "fix" something — restore the correct value instead.
#
# REQUIRED (server degrades without these):
#   QDRANT_URL, QDRANT_API_KEY, QDRANT_COLLECTION_NAME, ROOSYNC_SHARED_PATH
# STRONGLY RECOMMENDED (semantic search won't work without these):
#   EMBEDDING_API_KEY or OPENAI_API_KEY
#
# ── Loading & precedence (grounded in src/preload.ts, src/index.ts:44, src/start.ts,
#    mcp-wrapper.cjs) ──────────────────────────────────────────────────────────
# dotenv loads <server-root>/.env (index.ts uses quiet:true, #1140, to keep stdout
# JSON-RPC clean; mcp-wrapper.cjs loads it before spawning the server).
# dotenv NEVER overrides a variable already present in the OS environment:
# OS process env > .env file. #1628 fallback: if ROOSYNC_SHARED_PATH is absent
# from the environment, shared-state-path.ts re-reads .env directly.
#
# ── Boolean gates are STRICT LITERAL string comparisons ──────────────────────
# Every on/off gate in this file compares exact strings, e.g.
#   !== 'false' (default ON)  : ROO_INDEXING_ENABLED, SKELETON_*_TIER,
#                               NOTIFICATIONS_*, MESSAGE_AUTO_ARCHIVE_ENABLED, GLOBAL_NOTIF_ENABLED
#   === 'true' / === '1'      : QDRANT_SKIP_TLS_VERIFY, ROO_INDEX_CLAUDE_SESSIONS,
#                               UNIFIED_STORE_*, MCP_INCLUDE_STACKS, USE_NEW_PARSING, ...
#   === '0' (disable)         : SEARCH_DEDUP_ENABLED
# Any other value ('0', 'no', 'off', 'yes'...) is SILENTLY INOPERANT — the gate
# keeps its default. Use exactly the literal shown in each comment.
# =============================================================================

# Configuration Qdrant (base de données vectorielle)
QDRANT_URL=https://qdrant.example.com
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=roo_tasks_semantic_index

# Set to 'true' to disable TLS certificate verification for Qdrant connections
# Only needed if Qdrant uses a self-signed or untrusted certificate
# WARNING: This disables TLS verification for ALL connections in this process
# Prefer using NODE_EXTRA_CA_CERTS to trust specific CA certificates instead
# QDRANT_SKIP_TLS_VERIFY=true

# Client timeout for all Qdrant operations, in ms (#851 — default 15000)
# QDRANT_TIMEOUT_MS=15000
# Timeout for search queries, in ms (ms→s rounded up; default 30000)
# QDRANT_SEARCH_TIMEOUT_MS=30000
# Timeout of the roosync_health_view Qdrant probe, in ms (default 8000)
# QDRANT_HEALTH_PROBE_TIMEOUT_MS=8000
# 'true' logs the first upsert point on retry (400 diagnostics). Default: off
# QDRANT_VERBOSE=true

# Configuration Embeddings
# IMPORTANT: All machines MUST use the SAME embedding model and dimensions
# to share a single Qdrant collection. Mixing dimensions corrupts the index.

# API key for the self-hosted embedding service (REQUIRED for cross-machine indexing)
# This is separate from OPENAI_API_KEY - used specifically for embeddings.myia.io
EMBEDDING_API_KEY=your-embedding-api-key-here

# LLM Chat/Synthesis — OpenAI-compatible endpoint
# For self-hosted vLLM, set OPENAI_BASE_URL to the vLLM /v1 endpoint
# The OpenAI SDK reads OPENAI_BASE_URL automatically
# OPENAI_BASE_URL=https://api.medium.text-generation-webui.myia.io/v1
OPENAI_API_KEY=your-llm-api-key-here
OPENAI_CHAT_MODEL_ID=your-model-id-here

# Self-hosted embedding API base URL (REQUIRED for shared indexing)
# All machines MUST point to the same endpoint for vector compatibility
EMBEDDING_API_BASE_URL=https://embeddings.myia.io/v1

# Embedding model name (REQUIRED - must match across all machines)
EMBEDDING_MODEL=qwen3-4b-awq-embedding

# Embedding vector dimensions (REQUIRED - must match model output)
# qwen3-4b-awq-embedding = 2560, text-embedding-3-small = 1536
EMBEDDING_DIMENSIONS=2560

# Embedding client timeout, in ms (default 60000 — raised from 30s, see openai.ts)
# EMBEDDING_TIMEOUT_MS=60000
# Rate limit for embedding API calls, ops/min (default 10; metered-connection knob)
# EMBEDDING_OPS_PER_MINUTE=10
# Inputs per embedding API request (#2194 — default 16; 1 = legacy single-input path)
# EMBEDDING_BATCH_SIZE=16
# Approx max tokens per batch request before splitting (default 7000)
# EMBEDDING_BATCH_MAX_TOKENS=7000

# Batch size for Qdrant upserts during indexing (optional, defaults to 50)
# Lower values = safer but slower, higher = faster but more memory
# INDEXING_BATCH_SIZE=50

# =============================================================================
# #985 — INDEXING KILL-SWITCH (bandwidth-leak P0 controls)
# =============================================================================
# Disables ALL indexing on this machine: Worker A (skeleton refresh = disk scan)
# AND Worker B (Qdrant = embedding traffic), plus explicit index_task_semantic
# calls are refused. Default: unset = ON (identical to pre-#985 behaviour).
#
# ⚠️ CONTRACT IS STRICT LITERAL: the gate compares `process.env.ROO_INDEXING_ENABLED !== 'false'`
# (same convention as SKELETON_ARCHIVE_TIER). ONLY the exact string 'false' disables indexing.
# Setting ROO_INDEXING_ENABLED=0, no, or off is SILENTLY INOPERANT — indexing stays ON.
# Verified empirically on the built artifact (po-2025, 2026-08-14).
#
# Use case: metered-connection machines (bandwidth garrot). The throttle
# EMBEDDING_OPS_PER_MINUTE remains the fine-grained knob while indexing is on.
# ROO_INDEXING_ENABLED=false

# =============================================================================
# SEARCH TUNING
# =============================================================================
# Semantic-search retries on transient failures (#2167 — defaults 2 retries / 2000ms backoff)
# SEMANTIC_RETRY_COUNT=2
# SEMANTIC_RETRY_BACKOFF_MS=2000
# TTL of the in-memory query-embedding cache, in ms (default 3600000 = 1h)
# QUERY_EMBEDDING_CACHE_TTL_MS=3600000
# Result deduplication: '0' disables (default on), '1' on SEARCH_DEDUP_NORMALIZE
# enables normalized-key grouping (default exact)
# SEARCH_DEDUP_ENABLED=1
# SEARCH_DEDUP_NORMALIZE=1
# codebase_search embedding circuit-breaker TTL, in ms (#3279 — default 300000 = 5 min)
# CODEBASE_EMBEDDING_CB_TTL_MS=300000
# Cache TTL of the embedding-connectivity check in diagnose-index, in ms (#1275 — default 300000)
# DIAGNOSE_CONNECTIVITY_TTL_MS=300000
# search-semantic embedding circuit-breaker TTL, in ms (#1232 — default 300000)
# EMBEDDING_CIRCUIT_BREAKER_TTL_MS=300000

# =============================================================================
# INDEXING TUNING
# =============================================================================
# '1' or 'true' forces a full rescan bypassing the mtime incremental filter (#596)
# ROO_INDEX_FORCE=1
# Overrides the index schema version (default '1.2' = INDEX_VERSION_CURRENT, #2455)
# ROO_INDEX_VERSION=1.2
# 'true' lifts the Claude-sessions sanctuary and indexes claude-code sessions (#1985)
# ROO_INDEX_CLAUDE_SESSIONS=true
# Backoff window (ms) before retrying a 'rebuild' decision (defaults 2000 / 12000)
# ROO_INDEX_REBUILD_BACKOFF_MIN_MS=2000
# ROO_INDEX_REBUILD_BACKOFF_MAX_MS=12000
# Per-task indexing timeout, in SECONDS (default 300)
# INDEX_TASK_TIMEOUT_MS=300
# Runaway-session guards (#1758 / #2825 — defaults below)
# MAX_CHUNKS_PER_TASK=50000
# MAX_MESSAGES_PER_TASK=10000
# MAX_SUBCHUNKS_PER_CHUNK=2000
# Skeleton-cache tiers (#1747): default ON; only the exact string 'false' disables
# SKELETON_CLAUDE_TIER=false
# SKELETON_ARCHIVE_TIER=false
# '1' re-checks checksums of already-phase1-completed skeletons (default off)
# ROO_STRICT_CHECKSUM=1
# Noise-filter thresholds used by indexing decisions (defaults below)
# NOISE_FILTER_SCHEDULED_AGE_DAYS=30
# NOISE_FILTER_SCHEDULED_MIN_MESSAGES=200
# NOISE_FILTER_RUNAWAY_MESSAGES=10000
# NOISE_FILTER_RUNAWAY_SIZE_MB=100
# NOISE_FILTER_TOOL_RATIO=0.85
# NOISE_FILTER_COLD_ORPHAN_DAYS=180
# NOISE_FILTER_COLD_ORPHAN_MAX_MSG=5

# =============================================================================
# ROOSYNC CONFIGURATION
# =============================================================================
# Configuration pour l'intégration RooSync - Synchronisation multi-machines
# Documentation: docs/integration/02-points-integration-roosync.md
# Version: 2.0.0

# Chemin absolu vers le répertoire Google Drive partagé pour RooSync
# Ce répertoire contient les fichiers de synchronisation (.shared-state)
# Exemple Windows: G:/Mon Drive/Synchronisation/RooSync/.shared-state
# Exemple Mac/Linux: ~/Google Drive/Synchronisation/RooSync/.shared-state
ROOSYNC_SHARED_PATH=G:/Mon Drive/Synchronisation/RooSync/.shared-state

# Identifiant unique de cette machine (utilisé pour différencier les configurations)
# Format recommandé: NOM-MACHINE ou UUID
# Exemples: PC-PRINCIPAL, MAC-DEV, LAPTOP-WORK
ROOSYNC_MACHINE_ID=PC-PRINCIPAL

# Active/désactive la synchronisation automatique RooSync
# Si true, le système vérifie automatiquement les changements
# Si false, les synchronisations sont déclenchées manuellement via outils MCP
# Valeurs: true | false
ROOSYNC_AUTO_SYNC=false

# Stratégie de résolution des conflits de synchronisation
# - manual: L'utilisateur doit approuver manuellement chaque décision
# - auto-local: Préférence automatique pour les changements locaux
# - auto-remote: Préférence automatique pour les changements distants
# Valeurs: manual | auto-local | auto-remote
ROOSYNC_CONFLICT_STRATEGY=manual

# Niveau de verbosité des logs RooSync
# - debug: Tous les détails (développement)
# - info: Informations importantes (recommandé)
# - warn: Avertissements uniquement
# - error: Erreurs uniquement
# Valeurs: debug | info | warn | error
ROOSYNC_LOG_LEVEL=info

# Fleet partitioning: comma-separated machine IDs owning the indexing work.
# Unset = partition disabled, every machine indexes everything (task-partition.ts)
# ROO_FLEET_ROSTER=myia-ai-01,myia-po-2023,myia-po-2024

# Manual override of the local workspace ID (default: derived from WORKSPACE_PATH)
# ROOSYNC_WORKSPACE_ID=roo-extensions

# Base directory of the task archive (default: <shared>/../task-archive, TaskArchiver)
# ROOSYNC_ARCHIVE_PATH=G:/Mon Drive/Synchronisation/RooSync/task-archive
# Path recorded as config source in machine identity metadata (cosmetic, IdentityManager)
# ROOSYNC_CONFIG_PATH=
# File where RooSync compare logs are written (default: outputs/debug/roosync-compare.log)
# ROOSYNC_LOG_PATH=

# Passphrase encrypting env-payloads for `env:` config-sharing targets.
# REQUIRED by env rotation (min 32 chars). Leave unset to disable env rotation.
# Set out-of-band per fleet — never commit a real value here.
# ROOSYNC_ENV_KEY=

# Auto-archive of read+unread inbox messages (moved, never deleted). Default ON;
# only the exact string 'false' disables (#3150)
# MESSAGE_AUTO_ARCHIVE_ENABLED=false
# MESSAGE_AUTO_ARCHIVE_MAX_AGE_DAYS=30
# MESSAGE_AUTO_ARCHIVE_INTERVAL_HOURS=6
# MESSAGE_AUTO_ARCHIVE_UNREAD_MAX_AGE_DAYS=90

# Dynamic pattern: <SERVICE>_ENV_PATH (e.g. SK_AGENT_ENV_PATH) overrides the
# default config/<service>/.env target used by roosync_config env:publish/apply.
# Resolved at call time from the target name — no fixed list exists.

# =============================================================================
# SK-AGENT / VLLM API KEYS (self-hosted models on myia.io)
# =============================================================================
# Documentation: mcps/internal/servers/sk-agent/README.md

# LLM Chat/Synthesis — OpenAI-compatible endpoint
# For self-hosted vLLM, set OPENAI_BASE_URL to the vLLM /v1 endpoint
# The OpenAI SDK reads OPENAI_BASE_URL automatically
# OPENAI_BASE_URL=https://api.medium.text-generation-webui.myia.io/v1

# Clés pour les modèles self-hosted accessibles via sk-agent
# glm-4.7-flash text model (api.medium.text-generation-webui.myia.io)
VLLM_API_KEY_MEDIUM=your-vllm-medium-api-key-here
# zwz-8b vision model (api.mini.text-generation-webui.myia.io)
VLLM_API_KEY_MINI=your-vllm-mini-api-key-here

# =============================================================================
# #2719 — CLOUD FALLBACK for dashboard condensation
# =============================================================================
# When the primary local vLLM (OPENAI_BASE_URL) is down or returns null/exhausts
# retries, the dashboard condenser retries against a cloud model before falling
# back to lossy truncation. Inert-safe: if the key is absent, the fallback is a
# no-op and behaviour is identical to pre-#2719 (truncation-only on primary fail).
#
# All vars optional — the feature activates only when a key is present.
#   ZAI_API_KEY          (or FALLBACK_API_KEY)  — z.ai API key (required to activate)
#   ZAI_BASE_URL         (or FALLBACK_BASE_URL) — defaults https://api.z.ai/api/paas/v4
#   FALLBACK_LLM_MODEL_ID                      — defaults glm-4.7-flash
#   FALLBACK_TIMEOUT_MS                        — defaults 120000 (2 min, see #3016)
#
# z.ai subscription → base URL. The code defaults above match z.ai's PUBLIC
# docs, not this fleet's subscription. Provisioning a machine with ZAI_API_KEY
# alone therefore arms the fallback against a plan we do not hold — and it fails
# silently, at the exact moment it is needed. Observed on 2 fleet machines
# (#2719); ai-01, where the fallback path has actually been exercised, carries
# the three lines below.
#   - "max" / general (ZCODE)   : https://api.z.ai/api/paas/v4        ← code default
#   - GLM Coding Plan           : https://api.z.ai/api/coding/paas/v4 ← THIS FLEET
#
# → On a roo-extensions fleet machine, set all THREE, not just the key:
#     ZAI_API_KEY=<key>
#     ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
#     FALLBACK_LLM_MODEL_ID=glm-4.7
#
# ⚠️ paas vs paass: do NOT double the 'a' (common typo, simonw/llm#1347).
#ZAI_API_KEY=your-zai-cloud-api-key-here
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=
# FALLBACK_LLM_MODEL_ID=glm-4.7
# FALLBACK_TIMEOUT_MS=120000

# =============================================================================
# NOTIFICATIONS (push system + [NOTIF] footers)
# =============================================================================
# Master switches default ON — only the exact string 'false' disables.
# NOTIFICATIONS_ENABLED=false
# NOTIFICATIONS_MIN_PRIORITY=MEDIUM
# NOTIFICATIONS_CHECK_INBOX=false
# Footer kill switches (#3226a): FOOTER = every footer, GLOBAL = global dashboard only
# NOTIFICATIONS_FOOTER_ENABLED=false
# GLOBAL_NOTIF_ENABLED=false
# Max messages summarized in one footer (default 5)
# NOTIFICATIONS_MAX_COUNT=5
# Directory of the global-notification seen-state (default <server-root>/.roo-state-manager)
# GLOBAL_NOTIF_STATE_DIR=
# Minutes before re-notifying on a repeated global error (default 15)
# GLOBAL_NOTIF_ERROR_DELAY_MIN=15

# =============================================================================
# UNIFIED STORE (PostgreSQL dual-write, #3151)
# =============================================================================
# PG is opt-in: every gate below requires UNIFIED_STORE_PG_URL to be set.
# Connection string of the PG store (no default; feature inert without it)
# UNIFIED_STORE_PG_URL=postgresql://user:pass@host:5432/db
# '1' enables PG writes alongside the GDrive store (writer-factory gate)
# UNIFIED_STORE_DUAL_WRITE=1
# '1' makes PG the primary channel writer (requires DUAL_WRITE=1 + PG_URL, review #1030)
# UNIFIED_STORE_CHANNEL_PG_PRIMARY=1
# '1' reads the message channel from PG
# UNIFIED_STORE_CHANNEL_READ_PG=1
# '1' reads the dashboard from PG
# UNIFIED_STORE_DASHBOARD_READ_PG=1
# Max PG pool connections (default 5)
# UNIFIED_STORE_POOL_MAX=5
# PG statement timeout, in ms (default 5000)
# UNIFIED_STORE_TIMEOUT_MS=5000
# PG retention purge of archived messages, in days. Default 0 = purge disabled
# (opt-in, roosync_manage; GDrive is never touched)
# UNIFIED_STORE_CHANNEL_RETENTION_DAYS=0

# =============================================================================
# CONVERSATION BROWSING & DASHBOARD CONDENSATION
# =============================================================================
# conversation_browser tool timeouts, in ms (defaults 30000 / 90000 for archives)
# CONVERSATION_BROWSER_TIMEOUT_MS=30000
# CONVERSATION_BROWSER_ARCHIVE_TIMEOUT_MS=90000
# LLM call timeout for dashboard condensation, in ms (default 720000 = 12 min)
# CONDENSE_LLM_TIMEOUT_MS=720000
# TTL of the cross-process condensation file-lock (#2818 — default CONDENSE_LLM_TIMEOUT_MS + 180000)
# CONDENSE_LOCK_TTL_MS=900000
# Cross-process dashboard-append file-lock (#3205 — defaults 30000 / 5000 / 150)
# APPEND_LOCK_TTL_MS=30000
# APPEND_LOCK_ACQUIRE_BUDGET_MS=5000
# APPEND_LOCK_RETRY_MS=150

# =============================================================================
# EXPORT (export_data tool safety caps)
# =============================================================================
# EXPORT_MAX_PROJECT_CONVERSATIONS=50000
# EXPORT_MAX_PROJECT_BYTES=104857600

# =============================================================================
# DEBUG
# =============================================================================
# Verbose instruction-extraction logging across message extractors (35 read sites)
# ROO_DEBUG_INSTRUCTIONS=1
# Keep console.log unredirected in start.ts / mcp-wrapper.cjs (noisy — MCP stdout risk)
# ROO_DEBUG_LOGS=1
# Parsing A/B comparison harness (parsing-config.ts — strict literal 'true')
# USE_NEW_PARSING=true
# PARSING_COMPARISON_MODE=true
# LOG_PARSING_DIFFERENCES=true
# DEBUG_PARSING=1
# PARSING_SIMILARITY_THRESHOLD=44
# VALIDATE_IMPROVEMENTS=true
# MIN_CHILD_TASKS_IMPROVEMENT=10
# Workspace-detection debug in roo-storage-detector
# DEBUG_WORKSPACE=1
# DEBUG_WORKSPACE_FILTERING=1
# '1' appends stack traces to tool error payloads (error-format.ts; default off)
# MCP_INCLUDE_STACKS=1

# =============================================================================
# RUNTIME (paths & timeouts — rarely changed)
# =============================================================================
# WORKSPACE_PATH is INJECTED by mcp-wrapper.cjs (original cwd, or ${workspaceFolder}
# from the client config). Do not set it manually unless debugging workspace
# resolution — it feeds workspace detection, dashboard scoping and baselines.
# WORKSPACE_PATH=
# Default tool timeout applied by the MCP server, in ms (default 300000 = 5 min)
# MCP_TOOL_TIMEOUT_MS=300000
# Graceful-shutdown timeout, in ms (default 10000)
# SHUTDOWN_TIMEOUT_MS=10000
# Explicit PowerShell executable for PowerShellExecutor (else probed pwsh/powershell)
# POWERSHELL_PATH=C:/Program Files/PowerShell/7/pwsh.exe
# Path overrides for storage discovery (defaults: probed / d:/roo-extensions / cwd)
# ROO_HOME=d:/roo-extensions
# ROO_ROOT=
# ROO_EXTENSIONS_PATH=
# Zoo-Code compatibility (extension-paths.ts)
# ROO_EXTENSION_ID=zoocodeorganization.zoo-code
# ROO_VSCDB_KEY=
# Test/mock override of the shared-state dir (BaselineService; normally unset)
# SHARED_STATE_PATH=

# Platform vars read but NOT user-configured (diagnostics & guards, see diagnose.ts,
# server-helpers.ts): PATH, APPDATA, COMPUTERNAME, USERPROFILE, HOSTNAME, CI,
# GITHUB_ACTIONS, NODE_ENV, VITEST, WSL_DISTRO_NAME, DOCKER_HOST. NODE_TLS_REJECT_UNAUTHORIZED
# is written by the server itself when QDRANT_SKIP_TLS_VERIFY=true.
