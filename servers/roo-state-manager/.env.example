# =============================================================================
# CRITICAL — DO NOT EMPTY OR DELETE VALUES (Issue #1551)
# =============================================================================
# The MCP server validates these at startup (see src/index.ts REQUIRED_ENV_VARS).
# If any REQUIRED variable is empty or missing, the server calls process.exit(1).
# NEVER set a key to "" to "fix" something — restore the correct value instead.
#
# REQUIRED (server won't start without these):
#   QDRANT_URL, QDRANT_API_KEY, QDRANT_COLLECTION_NAME, ROOSYNC_SHARED_PATH
# STRONGLY RECOMMENDED (semantic search won't work without these):
#   EMBEDDING_API_KEY or OPENAI_API_KEY
# =============================================================================

# Configuration Qdrant (base de données vectorielle)
QDRANT_URL=https://qdrant.example.com
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=roo_tasks_semantic_index

# Set to 'true' to disable TLS certificate verification for Qdrant connections
# Only needed if Qdrant uses a self-signed or untrusted certificate
# WARNING: This disables TLS verification for ALL connections in this process
# Prefer using NODE_EXTRA_CA_CERTS to trust specific CA certificates instead
# QDRANT_SKIP_TLS_VERIFY=true

# Configuration Embeddings
# IMPORTANT: All machines MUST use the SAME embedding model and dimensions
# to share a single Qdrant collection. Mixing dimensions corrupts the index.

# API key for the self-hosted embedding service (REQUIRED for cross-machine indexing)
# This is separate from OPENAI_API_KEY - used specifically for embeddings.myia.io
EMBEDDING_API_KEY=your-embedding-api-key-here

# LLM Chat/Synthesis — OpenAI-compatible endpoint
# For self-hosted vLLM, set OPENAI_BASE_URL to the vLLM /v1 endpoint
# The OpenAI SDK reads OPENAI_BASE_URL automatically
# OPENAI_BASE_URL=https://api.medium.text-generation-webui.myia.io/v1
OPENAI_API_KEY=your-llm-api-key-here
OPENAI_CHAT_MODEL_ID=your-model-id-here

# Self-hosted embedding API base URL (REQUIRED for shared indexing)
# All machines MUST point to the same endpoint for vector compatibility
EMBEDDING_API_BASE_URL=https://embeddings.myia.io/v1

# Embedding model name (REQUIRED - must match across all machines)
EMBEDDING_MODEL=qwen3-4b-awq-embedding

# Embedding vector dimensions (REQUIRED - must match model output)
# qwen3-4b-awq-embedding = 2560, text-embedding-3-small = 1536
EMBEDDING_DIMENSIONS=2560

# Batch size for Qdrant upserts during indexing (optional, defaults to 50)
# Lower values = safer but slower, higher = faster but more memory
# INDEXING_BATCH_SIZE=50

# =============================================================================
# #985 — INDEXING KILL-SWITCH (bandwidth-leak P0 controls)
# =============================================================================
# Disables ALL indexing on this machine: Worker A (skeleton refresh = disk scan)
# AND Worker B (Qdrant = embedding traffic), plus explicit index_task_semantic
# calls are refused. Default: unset = ON (identical to pre-#985 behaviour).
#
# ⚠️ CONTRACT IS STRICT LITERAL: the gate compares `process.env.ROO_INDEXING_ENABLED !== 'false'`
# (same convention as SKELETON_ARCHIVE_TIER). ONLY the exact string 'false' disables indexing.
# Setting ROO_INDEXING_ENABLED=0, no, or off is SILENTLY INOPERANT — indexing stays ON.
# Verified empirically on the built artifact (po-2025, 2026-08-14).
#
# Use case: metered-connection machines (bandwidth garrot). The throttle
# EMBEDDING_OPS_PER_MINUTE remains the fine-grained knob while indexing is on.
# ROO_INDEXING_ENABLED=false

# =============================================================================
# ROOSYNC CONFIGURATION
# =============================================================================
# Configuration pour l'intégration RooSync - Synchronisation multi-machines
# Documentation: docs/integration/02-points-integration-roosync.md
# Version: 2.0.0

# Chemin absolu vers le répertoire Google Drive partagé pour RooSync
# Ce répertoire contient les fichiers de synchronisation (.shared-state)
# Exemple Windows: G:/Mon Drive/Synchronisation/RooSync/.shared-state
# Exemple Mac/Linux: ~/Google Drive/Synchronisation/RooSync/.shared-state
ROOSYNC_SHARED_PATH=G:/Mon Drive/Synchronisation/RooSync/.shared-state

# Identifiant unique de cette machine (utilisé pour différencier les configurations)
# Format recommandé: NOM-MACHINE ou UUID
# Exemples: PC-PRINCIPAL, MAC-DEV, LAPTOP-WORK
ROOSYNC_MACHINE_ID=PC-PRINCIPAL

# Active/désactive la synchronisation automatique RooSync
# Si true, le système vérifie automatiquement les changements
# Si false, les synchronisations sont déclenchées manuellement via outils MCP
# Valeurs: true | false
ROOSYNC_AUTO_SYNC=false

# Stratégie de résolution des conflits de synchronisation
# - manual: L'utilisateur doit approuver manuellement chaque décision
# - auto-local: Préférence automatique pour les changements locaux
# - auto-remote: Préférence automatique pour les changements distants
# Valeurs: manual | auto-local | auto-remote
ROOSYNC_CONFLICT_STRATEGY=manual

# Niveau de verbosité des logs RooSync
# - debug: Tous les détails (développement)
# - info: Informations importantes (recommandé)
# - warn: Avertissements uniquement
# - error: Erreurs uniquement
# Valeurs: debug | info | warn | error
ROOSYNC_LOG_LEVEL=info

# =============================================================================
# SK-AGENT / VLLM API KEYS (self-hosted models on myia.io)
# =============================================================================
# Documentation: mcps/internal/servers/sk-agent/README.md

# LLM Chat/Synthesis — OpenAI-compatible endpoint
# For self-hosted vLLM, set OPENAI_BASE_URL to the vLLM /v1 endpoint
# The OpenAI SDK reads OPENAI_BASE_URL automatically
# OPENAI_BASE_URL=https://api.medium.text-generation-webui.myia.io/v1

# Clés pour les modèles self-hosted accessibles via sk-agent
# glm-4.7-flash text model (api.medium.text-generation-webui.myia.io)
VLLM_API_KEY_MEDIUM=your-vllm-medium-api-key-here
# zwz-8b vision model (api.mini.text-generation-webui.myia.io)
VLLM_API_KEY_MINI=your-vllm-mini-api-key-here

# =============================================================================
# #2719 — CLOUD FALLBACK for dashboard condensation
# =============================================================================
# When the primary local vLLM (OPENAI_BASE_URL) is down or returns null/exhausts
# retries, the dashboard condenser retries against a cloud model before falling
# back to lossy truncation. Inert-safe: if the key is absent, the fallback is a
# no-op and behaviour is identical to pre-#2719 (truncation-only on primary fail).
#
# All vars optional — the feature activates only when a key is present.
#   ZAI_API_KEY          (or FALLBACK_API_KEY)  — z.ai API key (required to activate)
#   ZAI_BASE_URL         (or FALLBACK_BASE_URL) — defaults https://api.z.ai/api/paas/v4
#   FALLBACK_LLM_MODEL_ID                      — defaults glm-4.7-flash
#   FALLBACK_TIMEOUT_MS                        — defaults 120000 (2 min, see #3016)
#
# z.ai subscription → base URL. The code defaults above match z.ai's PUBLIC
# docs, not this fleet's subscription. Provisioning a machine with ZAI_API_KEY
# alone therefore arms the fallback against a plan we do not hold — and it fails
# silently, at the exact moment it is needed. Observed on 2 fleet machines
# (#2719); ai-01, where the fallback path has actually been exercised, carries
# the three lines below.
#   - "max" / general (ZCODE)   : https://api.z.ai/api/paas/v4        ← code default
#   - GLM Coding Plan           : https://api.z.ai/api/coding/paas/v4 ← THIS FLEET
#
# → On a roo-extensions fleet machine, set all THREE, not just the key:
#     ZAI_API_KEY=<key>
#     ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
#     FALLBACK_LLM_MODEL_ID=glm-4.7
#
# ⚠️ paas vs paass: do NOT double the 'a' (common typo, simonw/llm#1347).
#ZAI_API_KEY=your-zai-cloud-api-key-here